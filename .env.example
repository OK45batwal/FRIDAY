# FRIDAY Core Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*

# AI Provider Configuration (mock | openai | gemini | ollama)
AI_PROVIDER=mock
DEFAULT_MODEL=mock-friday-v1

# Cloud Providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Database
DATABASE_URL=sqlite+aiosqlite:///./friday.db

# Voice & Audio
TTS_PROVIDER=web_speech # options: web_speech, local, edge_tts
STT_PROVIDER=web_speech # options: web_speech, whisper
