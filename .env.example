# FRIDAY Configuration Template
APP_NAME=FRIDAY
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

HOST=127.0.0.1
PORT=8080

LLM_PROVIDER=ollama
LLM_MODEL=go1.0
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_TOKENS=512

DATABASE_URL=sqlite+aiosqlite:///./friday.db
SQLITE_DB_PATH=friday.db

ENABLE_MEMORY=true
ENABLE_VOICE=true
ENABLE_DEMO_MODE=true

# Laya Fast Decision Router (System 1)
ENABLE_LAYA=true
LAYA_CHECKPOINT=convaiinnovations/laya
LAYA_PRELOAD=true
LAYA_CONFIDENCE_THRESHOLD=0.85
LAYA_DEVICE=

LOG_LEVEL=INFO
