# FRIDAY Configuration Template
FRIDAY_APP_NAME=FRIDAY
FRIDAY_APP_VERSION=2.0.0
FRIDAY_ENVIRONMENT=development
FRIDAY_DEBUG=true

FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8080

LLM_PROVIDER=ollama
LLM_MODEL=go1.0
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_TOKENS=512

DATABASE_URL=sqlite+aiosqlite:///./friday.db
SQLITE_DB_PATH=friday.db

ENABLE_MEMORY=true
ENABLE_VOICE=true
ENABLE_DEMO_MODE=true

# Laya Fast Decision Router (System 1)
ENABLE_LAYA=true
LAYA_CHECKPOINT=convaiinnovations/laya
LAYA_PRELOAD=true
LAYA_CONFIDENCE_THRESHOLD=0.85
LAYA_DEVICE=

# Security & Access Control
FRIDAY_API_KEY=
FRIDAY_ALLOW_REMOTE=false
FRIDAY_WORKSPACE_ROOT=.

# Voice & Speech Policy (P0-B)
FRIDAY_TTS_MODE=local
FRIDAY_TTS_ALLOW_CLOUD=false
FRIDAY_MAX_VOICE_PAYLOAD_BYTES=10485760
FRIDAY_MAX_TTS_TEXT_LENGTH=4000

LOG_LEVEL=INFO
