{
  "name": "friday-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",

  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json',JSON.stringify({type:'commonjs'})+'\\n')\"",
    "start:electron": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win"
  },
  "build": {
    "appId": "com.friday.assistant",
    "productName": "FRIDAY",
    "copyright": "Copyright © 2026 Omkar. All rights reserved.",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../services/core",
        "to": "services/core",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/memory_data/**",
          "!**/learning_data/**",
          "!friday.db*"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",

    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version} Installer",
      "iconSize": 110,
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FRIDAY"
    }
  },

  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "7.6.8",
    "@capacitor/core": "8.5.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^4.1.11"
  }
}
