<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060913"
    android:padding="28dp"
    android:gravity="center">

    <!-- Glowing Arc Reactor Logo -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/shape_glowing_dot"
        android:layout_marginBottom="24dp" />

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FRIDAY ASSISTANT"
        android:textColor="#f8fafc"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvAssistantStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Default Android Digital Assistant"
        android:textColor="#38bdf8"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="32dp" />

    <!-- Feature Description Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_assistant_sheet"
        android:padding="20dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ How to Summon from Any Screen:"
            android:textColor="#cbd5e1"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Long-press Power button / Home button\n• Swipe from bottom corner of your screen\n• Controls Flashlight, Alarms, Calls, &amp; WhatsApp"
            android:textColor="#94a3b8"
            android:textSize="12.5sp"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>

    <!-- Set Default Assistant Button -->
    <Button
        android:id="@+id/btnSetDefault"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="1. Set as Default Assistant ⚙️"
        android:textColor="#ffffff"
        android:backgroundTint="#f43f5e"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="12dp" />

    <!-- Test Assistant Trigger Button -->
    <Button
        android:id="@+id/btnTestAssistant"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="2. Test Voice HUD Overlay 🎙️"
        android:textColor="#38bdf8"
        android:backgroundTint="#1e293b"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
