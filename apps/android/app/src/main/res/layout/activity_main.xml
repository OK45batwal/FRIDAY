<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060913"
    android:padding="16dp">

    <!-- 1. Ambient "My Day" Personalized Glance Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true">

            <TextView
                android:id="@+id/tvPersonalizedGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good evening, Sir"
                android:textColor="#f8fafc"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvGlanceDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wednesday, Aug 26"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#64748b"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvGlanceBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋 100%"
                    android:textColor="#38bdf8"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#38bdf8"
            android:layout_alignParentEnd="true"
            android:contentDescription="Settings" />
    </RelativeLayout>

    <!-- 2. Google-Style Suggestion Chips Horizontal Carousel -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipWakeWordToggle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🎙️ Wake Word: ON"
                android:textColor="#10b981"
                android:background="@drawable/bg_chip_pill"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipGoodMorning"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🌅 Good Morning"
                android:textColor="#f8fafc"
                android:background="@drawable/bg_chip_pill"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipTimer"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="⏰ 5m Timer"
                android:textColor="#f8fafc"
                android:background="@drawable/bg_chip_pill"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipYouTube"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="▶️ Open YouTube"
                android:textColor="#f8fafc"
                android:background="@drawable/bg_chip_pill"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipFlashlight"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🔦 Flashlight"
                android:textColor="#f8fafc"
                android:background="@drawable/bg_chip_pill"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipFlipCoin"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🪙 Flip a Coin"
                android:textColor="#f8fafc"
                android:background="@drawable/bg_chip_pill"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipReminders"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="📝 My Reminders"
                android:textColor="#f8fafc"
                android:background="@drawable/bg_chip_pill"
                android:textSize="11.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. Scrollable Conversation View & Rich Interactive Cards -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 4. Central Voice Stage & Speech Subtitle Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ READY • SAY 'HEY FRIDAY'"
            android:textColor="#38bdf8"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <!-- Google Assistant Signature 4-Color Glowing Light Bar -->
        <View
            android:id="@+id/lightBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@drawable/bg_gradient_lightbar"
            android:alpha="0.7" />
    </LinearLayout>

    <!-- 5. Floating Bottom Dock Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Glowing Voice Orb Button -->
        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp">

            <View
                android:id="@+id/orbGlow"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/shape_glowing_dot" />

            <ImageButton
                android:id="@+id/btnVoice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="#ffffff"
                android:contentDescription="Voice" />
        </FrameLayout>

        <!-- Search / Speech Input Bar -->
        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ambient_card"
            android:hint="Ask anything or 'Hey Friday'..."
            android:textColorHint="#64748b"
            android:textColor="#f8fafc"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <!-- Send Action Button -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#38bdf8"
            android:layout_marginStart="8dp"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
