<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#05070E"
    android:padding="16dp">

    <!-- Top App Bar & Settings Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FRIDAY 1.0"
                    android:textColor="#f8fafc"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ SYSTEM READY • SAY 'HEY FRIDAY'"
                    android:textColor="#38bdf8"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#38bdf8"
            android:layout_alignParentEnd="true"
            android:contentDescription="Settings" />
    </RelativeLayout>

    <!-- Quick Action Chips Horizontal ScrollView -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipWakeWordToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🎙️ Wake Word: ON"
                android:textColor="#10b981"
                android:background="@drawable/bg_assistant_sheet"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipSetDefault"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⚙️ Set Default Assistant"
                android:textColor="#ffffff"
                android:background="@drawable/bg_assistant_sheet"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipTestOverlay"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🧪 Test Floating HUD"
                android:textColor="#38bdf8"
                android:background="@drawable/bg_assistant_sheet"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipFlashlight"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔦 Flashlight"
                android:textColor="#cbd5e1"
                android:background="@drawable/bg_assistant_sheet"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipTimer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⏰ 10m Timer"
                android:textColor="#cbd5e1"
                android:background="@drawable/bg_assistant_sheet"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipReminders"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📝 My Reminders"
                android:textColor="#cbd5e1"
                android:background="@drawable/bg_assistant_sheet"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/chipBattery"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔋 Battery Status"
                android:textColor="#cbd5e1"
                android:background="@drawable/bg_assistant_sheet"
                android:textSize="11.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Scrollable Chat History Screen -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_assistant_sheet"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Voice Visualizer Orb & Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Glowing Voice Orb Button with Multi-Ring Arc Reactor Effect -->
        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp">

            <View
                android:id="@+id/orbGlow"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/shape_glowing_dot" />

            <ImageButton
                android:id="@+id/btnVoice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="#ffffff"
                android:contentDescription="Voice" />
        </FrameLayout>

        <!-- Text Input Field -->
        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_assistant_sheet"
            android:hint="Ask or say 'Hey Friday'..."
            android:textColorHint="#64748b"
            android:textColor="#f8fafc"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp"
            android:singleLine="true" />

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#38bdf8"
            android:layout_marginStart="8dp"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
